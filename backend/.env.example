# --- Supabase ---
# Tableau de bord Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé service_role : contourne les RLS. Backend uniquement, JAMAIS exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# claude-sonnet-5   : suit fidèlement les consignes de format (défaut)
# claude-haiku-4-5  : ~3x moins cher et plus rapide, mais dérape sur le format
CHAT_MODEL=claude-sonnet-5

# --- Voyage AI (embeddings pour le RAG) ---
# https://dashboard.voyageai.com/
VOYAGE_API_KEY=
# Doit être IDENTIQUE à celui de scripts/.env : changer de modèle rend les
# vecteurs déjà en base inutilisables (il faut tout ré-embedder).
VOYAGE_MODEL=voyage-3

# --- Serveur ---
PORT=3001
NODE_ENV=development

# Origines autorisées par CORS (séparées par des virgules).
# En prod : uniquement le domaine du site Wenoble.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://wenoble.com

# --- Session ---
# Signe le cookie de session (32 caractères minimum). À générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Le changer invalide toutes les sessions en cours.
COOKIE_SECRET=

# `lax`  : widget et API sur le même domaine racine (wenoble.com + api.wenoble.com)
# `none` : API sur un domaine différent — impose HTTPS (cookie Secure obligatoire)
COOKIE_SAMESITE=lax
# Optionnel : pour partager le cookie entre sous-domaines, ex. .wenoble.com
COOKIE_DOMAIN=

# --- Garde-fous /chat ---
# Débit par IP.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=5 minutes
# Plafond total de messages pour une même session.
MAX_MESSAGES_PER_CONVERSATION=40
