SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Ingestion ---
# Site à crawler : le script tente d'abord <SITE_BASE_URL>/sitemap.xml,
# puis retombe sur un crawl des liens internes depuis la page d'accueil.
SITE_BASE_URL=https://wenoble.com

# PDF du brandbook : chemin d'un fichier .pdf OU d'un dossier (parcouru en
# récursif). Relatif au dossier scripts/.
BRANDBOOK_DIR=./content

# Nombre max de pages crawlées. Le dépassement est signalé dans la console.
MAX_PAGES=500

# Motifs d'URL à exclure (regex, séparées par des virgules).
# Ex. pour ne pas indexer le blog : EXCLUDE_URL_PATTERNS=/blog/
EXCLUDE_URL_PATTERNS=

# Les pages correspondant à ce motif sont taguées `blog` (et non `site`),
# pour pouvoir les pondérer plus bas lors de la recherche.
BLOG_URL_PATTERN=^/blog/
