# Service systemd du backend Fastify.
#
# Installation :
#   sudo cp deploy/wenoble-chatbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now wenoble-chatbot
#
# Logs : journalctl -u wenoble-chatbot -f

[Unit]
Description=Wenoble Chatbot API (Fastify)
After=network.target

[Service]
Type=simple
User=wenoble
WorkingDirectory=/opt/wenoble-chatbot/backend

# Pas d'EnvironmentFile ici : le code charge lui-même backend/.env via dotenv, et
# systemd refuserait de toute façon une valeur contenant un espace non échappé
# (RATE_LIMIT_WINDOW=5 minutes).
#
# Le fichier .env doit être en chmod 600 et appartenir à l'utilisateur `wenoble` :
# il contient la clé service_role, qui contourne toute RLS.
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5

# Redémarrage propre : Fastify ferme ses connexions sur SIGTERM (voir server.ts).
KillSignal=SIGTERM
TimeoutStopSec=20

# Durcissement : le process n'a aucune raison d'écrire ailleurs que dans /tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wenoble-chatbot

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
